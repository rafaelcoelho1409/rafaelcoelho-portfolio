---
import Base from "./Base.astro";
import StackBadge from "../components/StackBadge.astro";

export interface Props {
  title: string;
  summary: string;
  outcome?: string;
  date: Date;
  stack: string[];
  repo?: string;
  demo?: string;
  paper?: string;
}

const { title, summary, outcome, date, stack, repo, demo, paper } = Astro.props;
const featuredStack = stack.slice(0, 5);
const additionalStack = stack.slice(5);

const dateLabel = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
})
  .format(date)
  .toUpperCase();

const links = [
  repo && { label: "View source on GitHub", href: repo },
  demo && { label: "Open live demo", href: demo },
  paper && { label: "Read research paper", href: paper },
].filter(Boolean) as { label: string; href: string }[];
---

<Base title={title} description={summary} article>
  <article class="container-wide">
    <a
      href="/work"
      class="mb-5 inline-flex items-center gap-1 font-mono text-[11px] tracking-[0.14em] uppercase transition-colors hover:text-[var(--color-gold)]"
      style="color: var(--color-platinum-dim);"
    >
      ← Selected work
    </a>

    <header class="mb-7">
      <p
        class="eyebrow mb-2"
        style="font-family: var(--font-mono);"
      >
        Case study · {dateLabel}
      </p>
      <h1
        class="font-display mb-3 text-[2rem] leading-[1.1] font-medium tracking-tight sm:text-[2.5rem] lg:text-[3rem]"
        style="color: var(--color-text); letter-spacing: -0.028em;"
      >
        {title}
      </h1>
      <p class="max-w-3xl text-[15px] leading-[1.55] sm:text-[17px] sm:leading-[1.65]" style="color: var(--color-text-muted);">
        {summary}
      </p>

      {outcome && (
        <div
          class="mt-4 max-w-4xl border-l-2 py-1 pl-4 sm:pl-5"
          style="border-color: var(--color-gold-deep);"
        >
          <div
            class="mb-1 font-mono text-[10px] tracking-[0.2em] uppercase"
            style="color: var(--color-gold);"
          >
            Delivery evidence
          </div>
          <div class="text-[14px] leading-[1.55] sm:text-[15px]" style="color: var(--color-text);">
            {outcome}
          </div>
        </div>
      )}

      {stack.length > 0 && (
        <div class="mt-4 flex flex-wrap items-center gap-1.5" role="group" aria-label="Key technologies">
          <span class="label-mono mr-1 text-[10px]">Stack</span>
          {featuredStack.map((s) => <StackBadge name={s} />)}
          {additionalStack.length > 0 && (
            <details class="relative w-full sm:w-auto">
              <summary class="inline-flex cursor-pointer list-none items-center rounded-sm border px-2 py-1 font-mono text-[10px] tracking-wide transition-colors hover:border-[var(--color-gold)] hover:text-[var(--color-gold)] [&::-webkit-details-marker]:hidden" style="border-color: var(--color-border); color: var(--color-platinum-dim);">
                Show {additionalStack.length} more technologies
              </summary>
              <div class="mt-2 flex flex-wrap gap-1.5 border-l pl-3 sm:absolute sm:z-10 sm:max-w-2xl sm:bg-[var(--color-bg-2)] sm:p-3" style="border-color: var(--color-border-strong);">
                {additionalStack.map((s) => <StackBadge name={s} />)}
              </div>
            </details>
          )}
        </div>
      )}

      {links.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2 font-mono text-[11px] tracking-tight">
          {links.map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noreferrer noopener"
              class="rounded-sm border px-3 py-2 transition-colors hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]"
              style="border-color: var(--color-border-strong); color: var(--color-text);"
            >
              {l.label} ↗
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="hairline-gold mb-8" style="opacity: 0.35;"></div>

    <div class="prose-content">
      <slot />
    </div>
  </article>
</Base>
