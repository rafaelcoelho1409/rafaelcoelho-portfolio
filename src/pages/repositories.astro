---
import Base from "../layouts/Base.astro";
import StackBadge from "../components/StackBadge.astro";
import { REPOS, GITHUB_USERNAME } from "../data/repositories";

const featured = REPOS.filter((repo) => repo.spotlight);
const featuredRepos = new Set(featured.map((repo) => repo.repo));
const archive = REPOS.filter((repo) => !featuredRepos.has(repo.repo));

const grouped = archive.reduce<Record<number, typeof archive>>((acc, repo) => {
  (acc[repo.year] ||= []).push(repo);
  return acc;
}, {});

const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);
---

<Base
  title="Repositories"
  description="Explore two flagship AI and MLOps platforms, then browse 18 more public repositories by year."
>
  <div class="container-wide">
    <header class="mb-12 pt-4">
      <p class="eyebrow mb-4">/ Repositories</p>
      <h1
        class="font-display mb-4 text-[2.4rem] font-medium tracking-tight"
        style="color: var(--color-text); letter-spacing: -0.025em;"
      >
        Public repositories
      </h1>
      <p class="max-w-3xl text-[17px] leading-[1.7]" style="color: var(--color-text-muted);">
        Explore my flagship AI and MLOps platforms, then browse the complete archive
        of {REPOS.length} public projects.
      </p>
    </header>

    <section class="mb-14" aria-labelledby="flagship-heading">
      <div class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="flagship-heading" class="label-mono">Flagship systems</h2>
        <a
          href={`https://github.com/${GITHUB_USERNAME}?tab=repositories`}
          target="_blank"
          rel="noreferrer noopener"
          class="min-h-11 inline-flex items-center font-mono text-xs tracking-wide transition-colors hover:text-[var(--color-gold)]"
          style="color: var(--color-platinum);"
        >
          Browse GitHub repositories ↗
        </a>
      </div>

      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        {featured.map((repo, index) => (
          <article
            class="flex h-full flex-col rounded-sm border p-5 sm:p-6"
            style={`border-color: ${index === 0 ? "var(--color-gold-deep)" : "var(--color-border-strong)"}; background-color: var(--color-bg-2);`}
          >
            <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
              <p class="font-mono text-[11px] tracking-[0.12em] uppercase" style="color: var(--color-gold);">
                {repo.spotlight?.label}
              </p>
              <span class="font-mono text-xs uppercase tracking-wide" style="color: var(--color-platinum-dim);">
                {repo.releaseDate}
              </span>
            </div>

            <h3 class="font-display mb-3 text-[22px] font-semibold tracking-tight" style="color: var(--color-text);">
              {repo.projectName}
            </h3>
            <p class="mb-5 text-[15px] leading-[1.7]" style="color: var(--color-text-muted);">
              {repo.spotlight?.summary}
            </p>

            <ul class="mb-5 grid grid-cols-1 gap-2 border-y py-3 sm:grid-cols-3 sm:gap-3" style="border-color: var(--color-border);">
              {repo.spotlight?.proofPoints.map((point) => (
                <li class="font-mono text-[12px] leading-relaxed" style="color: var(--color-platinum);">
                  {point}
                </li>
              ))}
            </ul>

            <div class="mb-6 flex flex-wrap gap-1.5">
              {repo.spotlight?.tools.map((tool) => <StackBadge name={tool} />)}
            </div>

            <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[13px]">
              {repo.caseStudy && (
                <a
                  href={repo.caseStudy}
                  class="min-h-11 inline-flex items-center transition-colors hover:text-[var(--color-gold)]"
                  style="color: var(--color-gold);"
                >
                  Read case study →
                </a>
              )}
              <a
                href={`https://github.com/${repo.repo}`}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`View ${repo.projectName} source on GitHub`}
                class="min-h-11 inline-flex items-center transition-colors hover:text-[var(--color-gold)]"
                style="color: var(--color-platinum);"
              >
                Source on GitHub ↗
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="hairline-gold mb-12" style="opacity: 0.35;"></div>

    <section aria-labelledby="repo-archive-heading">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h2 id="repo-archive-heading" class="label-mono mb-2">Complete repository archive</h2>
          <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
            {archive.length} additional projects, grouped by release year.
          </p>
        </div>
        <span class="font-mono text-xs tracking-wide" style="color: var(--color-platinum-dim);">
          {years[years.length - 1]}–{years[0]}
        </span>
      </div>

      <div class="space-y-9">
        {years.map((year) => (
          <section aria-labelledby={`year-${year}`}>
            <div class="mb-3 flex items-baseline gap-3">
              <h3 id={`year-${year}`} class="font-display text-2xl font-semibold tracking-tight" style="color: var(--color-gold);">
                {year}
              </h3>
              <span class="font-mono text-[11px] tracking-[0.12em] uppercase" style="color: var(--color-platinum-dim);">
                {grouped[year].length} {grouped[year].length === 1 ? "repository" : "repositories"}
              </span>
            </div>

            <ul class="divide-y border-y" style="border-color: var(--color-border);">
              {grouped[year].map((repo) => (
                <li class="grid gap-2 py-4 md:grid-cols-[minmax(0,1fr)_minmax(180px,auto)_auto] md:items-center md:gap-5">
                  <div class="min-w-0">
                    <h4 class="font-display text-[15.5px] font-semibold leading-snug" style="color: var(--color-text);">
                      {repo.projectName}
                    </h4>
                    <p class="mt-1 font-mono text-[11px] uppercase tracking-wide" style="color: var(--color-platinum-dim);">
                      {repo.releaseDate}
                    </p>
                  </div>

                  <div class="flex flex-wrap items-center gap-1.5">
                    {repo.keyTools.slice(0, 3).map((tool) => <StackBadge name={tool} />)}
                    {repo.keyTools.length > 3 && (
                      <span class="px-1 font-mono text-xs" style="color: var(--color-text-dim);">
                        +{repo.keyTools.length - 3}
                      </span>
                    )}
                  </div>

                  <div class="flex min-h-11 flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs">
                    {repo.caseStudy && (
                      <a
                        href={repo.caseStudy}
                        class="min-h-11 inline-flex items-center transition-colors hover:text-[var(--color-gold)]"
                        style="color: var(--color-gold);"
                      >
                        Case study →
                      </a>
                    )}
                    <a
                      href={`https://github.com/${repo.repo}`}
                      target="_blank"
                      rel="noreferrer noopener"
                      aria-label={`View ${repo.projectName} source on GitHub`}
                      class="min-h-11 inline-flex items-center transition-colors hover:text-[var(--color-gold)]"
                      style="color: var(--color-platinum);"
                    >
                      GitHub ↗
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </div>
</Base>
