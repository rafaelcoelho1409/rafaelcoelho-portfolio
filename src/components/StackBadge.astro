---
export interface Props {
  name: string;
}
const { name } = Astro.props;
---

<span
  class="inline-flex min-h-7 items-center rounded-full border px-2.5 py-1 font-mono text-xs tracking-tight"
  style="border-color: var(--color-border); background-color: var(--color-bg-2); color: var(--color-platinum);"
>
  {name}
</span>
