---
export interface Props {
  src: string;
  height?: string;
  ariaLabel?: string;
  downloadLabel?: string;
}

const {
  src,
  height = "min(70vh, 720px)",
  ariaLabel = "PDF viewer",
  downloadLabel = "Download PDF",
} = Astro.props;
---

<div class="pdf-viewer-wrap">
  <div
    class="pdf-viewer-container rounded-sm border"
    data-pdf-src={src}
    style={`height: ${height}; border-color: var(--color-gold-deep); background-color: var(--color-bg-2);`}
    role="region"
    aria-label={ariaLabel}
  >
    <div
      class="pdf-viewer-placeholder"
      style="display: flex; align-items: center; justify-content: center; height: 100%; padding: 1rem; text-align: center; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; color: var(--color-platinum-dim);"
    >
      <span data-pdf-placeholder>Presentation loads when it comes into view.</span>
    </div>
  </div>
  <div class="mt-3 flex justify-end">
    <a
      href={src}
      target="_blank"
      rel="noreferrer noopener"
      class="font-mono text-[11px] tracking-[0.14em] uppercase transition-colors hover:text-[var(--color-gold)]"
      style="color: var(--color-platinum-dim);"
    >
      {downloadLabel} ↗
    </a>
  </div>
</div>

<style is:global>
  .pdf-viewer-container > :not(.pdf-viewer-placeholder) {
    border-radius: 1px;
  }
  .pdf-viewer-container iframe,
  .pdf-viewer-container > div:not(.pdf-viewer-placeholder) {
    width: 100% !important;
    height: 100% !important;
  }
</style>

<script is:inline type="module">
  let embedPdfPromise;
  let viewerObserver;

  async function initializePdfViewer(el) {
    if (el.dataset.pdfInit) return;
    el.dataset.pdfInit = "loading";
    const placeholder = el.querySelector("[data-pdf-placeholder]");
    if (placeholder) placeholder.textContent = "Loading presentation…";

    try {
      embedPdfPromise ??= import(
        "https://cdn.jsdelivr.net/npm/@embedpdf/snippet@2/dist/embedpdf.js"
      )
        .then(({ default: EmbedPDF }) => EmbedPDF)
        .catch((err) => {
          embedPdfPromise = undefined;
          throw err;
        });
      const EmbedPDF = await embedPdfPromise;
      EmbedPDF.init({
        type: "container",
        target: el,
        src: el.dataset.pdfSrc,
      });
      el.dataset.pdfInit = "ready";
      el.querySelector(".pdf-viewer-placeholder")?.remove();
    } catch (err) {
      delete el.dataset.pdfInit;
      console.error("[PdfViewer] initialization failed", err);
      if (placeholder)
        placeholder.textContent = "Viewer unavailable — use the PDF link below.";
    }
  }

  function initPdfViewers() {
    const targets = document.querySelectorAll("[data-pdf-src]:not([data-pdf-init])");
    if (!targets.length) return;

    if (!("IntersectionObserver" in window)) {
      targets.forEach((el) => initializePdfViewer(el));
      return;
    }

    viewerObserver ??= new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        viewerObserver.unobserve(entry.target);
        initializePdfViewer(entry.target);
      });
    }, { rootMargin: "150px 0px" });

    targets.forEach((el) => viewerObserver.observe(el));
  }

  initPdfViewers();
  document.addEventListener("astro:page-load", initPdfViewers);
  document.addEventListener("astro:before-swap", () => {
    viewerObserver?.disconnect();
    viewerObserver = undefined;
  });
</script>
