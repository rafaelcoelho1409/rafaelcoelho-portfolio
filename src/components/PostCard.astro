---
export interface Props {
  title: string;
  summary: string;
  href: string;
  date: Date;
  tags?: string[];
  readingTime: number;
}

const { title, summary, href, date, tags = [], readingTime } = Astro.props;

const dateLabel = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
})
  .format(date)
  .toUpperCase();
---

<article
  class="border-b py-6 first:border-t"
  style="border-color: var(--color-border);"
>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
    <h2
      class="font-display text-[19px] font-semibold tracking-tight"
      style="color: var(--color-text); letter-spacing: -0.018em;"
    >
      <a
        href={href}
        class="transition-colors hover:text-[var(--color-gold)]"
      >
        {title}
      </a>
    </h2>
    <div
      class="flex shrink-0 items-baseline gap-2 font-mono text-[10.5px] tracking-[0.1em] whitespace-nowrap"
      style="color: var(--color-platinum-dim);"
    >
      <time datetime={date.toISOString()}>{dateLabel}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime} MIN READ</span>
    </div>
  </div>
  <p class="mt-2.5 text-[14.5px] leading-relaxed" style="color: var(--color-text-muted);">
    {summary}
  </p>
  {tags.length > 0 && (
    <ul aria-label="Topics" class="mt-3 flex flex-wrap gap-2">
      {tags.slice(0, 2).map((t) => (
        <li
          class="rounded-full border px-2.5 py-1 font-mono text-[9.5px] tracking-[0.08em] uppercase"
          style="border-color: var(--color-border); color: var(--color-text-dim);"
        >
          {t}
        </li>
      ))}
    </ul>
  )}
</article>
