---
import { NAV } from "../consts";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-30"
  style="background-color: var(--color-bg);"
>
  <div class="container-wide flex flex-col gap-1 py-2 sm:h-16 sm:flex-row sm:items-center sm:justify-between sm:py-0">
    <a
      href="/"
      class="flex min-h-10 shrink-0 items-center font-display font-medium tracking-tight transition-colors hover:text-[var(--color-gold)]"
      style="color: var(--color-text); letter-spacing: -0.018em;"
    >
      <span class="text-[20px]">Rafael</span>
      <span
        class="mx-1.5 align-baseline text-[17px]"
        style="color: var(--color-gold);"
        aria-hidden="true">·</span
      >
      <span
        class="text-[19px] uppercase"
        style="letter-spacing: 0.16em; font-weight: 600;">COELHO</span
      >
    </a>

    <nav class="nav-scroll flex max-w-full items-center gap-1 overflow-x-auto text-[13px] sm:ml-6" aria-label="Primary">
      {
        NAV.map((item) => {
          const active =
            path === item.href ||
            (item.href !== "/" && path.startsWith(item.href));
          return (
            <a
              href={item.href}
              class="min-h-10 shrink-0 rounded-sm border-b-2 px-3 py-2 font-medium tracking-tight transition-colors hover:text-[var(--color-text)]"
              style={`border-color: ${active ? "var(--color-gold-deep)" : "transparent"}; color: ${active ? "var(--color-text)" : "var(--color-text-dim)"};`}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
  <div class="hairline-gold"></div>
</header>
